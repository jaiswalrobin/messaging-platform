# Postgres
DB_HOST=localhost
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# CORS — comma-separated origins (default: allow all, dev only)
CORS_ORIGIN=

# Gateway REST base for internal calls from api
GATEWAY_URL=http://localhost:8080

# Internal key shared between api and gateway for internal endpoints
INTERNAL_API_KEY=

# Redis (chat-gateway)
REDIS_HOST=localhost
REDIS_PORT=

# Cassandra (chat-gateway)
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_LOCAL_DC=
CASSANDRA_KEYSPACE=

# Kafka (chat-gateway) — comma-separated broker list; the chat-events topic is
# auto-created by the gateway at boot. Receipts are dead without a broker.
KAFKA_BROKERS=localhost:9092
