# Postgres
DB_HOST=localhost
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# CORS — comma-separated origins (default: allow all, dev only)
CORS_ORIGIN=

# Gateway REST base for internal calls from api
GATEWAY_URL=http://localhost:8080

# Internal key shared between api and gateway for internal endpoints
INTERNAL_API_KEY=

# Redis (chat-gateway)
REDIS_HOST=localhost
REDIS_PORT=

# Cassandra (chat-gateway)
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_LOCAL_DC=
CASSANDRA_KEYSPACE=

# Kafka (chat-gateway producer + mss consumer) — comma-separated broker list;
# the chat-events topic is auto-created by the gateway at boot. Receipts are dead
# without a broker.
KAFKA_BROKERS=localhost:9092

# mss service (the Kafka consumer / MSS role)
MSS_PORT=8081
# Gateway → mss base URL for the REST history proxy
MSS_URL=http://localhost:8081

# Gateway instance id for the shared Redis connection registry (must be unique
# per gateway instance; default node-1)
NODE_ID=node-1
